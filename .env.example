PORT=3030

# MySQL (used by docker-compose for the mysql service and the app)
MYSQL_ROOT_PASSWORD=change-me

# Postgres for message logging (used by docker-compose; internal only)
POSTGRES_PASSWORD=change-me

# Postgres connection for local (non-docker) runs
# POSTGRES_HOST=localhost
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=
# POSTGRES_PORT=5432
# POSTGRES_DB=whatsapp

# MySQL connection for local (non-docker) runs
# MYSQL_HOST=localhost
# MYSQL_USER=root
# MYSQL_PASSWORD=
# MYSQL_PORT=3306
# MYSQL_DATABASE=whatsapp

# Country code prepended to local phone numbers in bulk sends
COUNTRY_CODE=20

# Delay between messages in bulk sends (ms) — keep high to reduce ban risk
MESSAGE_DELAY_MS=60000

# Group JID that receives the xlsx send report (empty = no report)
REPORT_GROUP_ID=

# Max upload size in MB
MAX_UPLOAD_MB=50
